# PostgreSQL connection strings (for example, from Neon or Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Use a long, random value. Do not commit the real secret.
AUTH_SECRET="replace-with-a-long-random-secret"

# Google Gemini API key
GEMINI_API_KEY="replace-with-your-gemini-api-key"

# true = answer from the FAQ table, false = answer directly from the model
AI_USE_FAQ="false"

# Keep false during normal use. Set to true temporarily only when running demo seed.
ALLOW_DESTRUCTIVE_SEED="false"
